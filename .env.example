# GiftLedger environment variables
# ------------------------------------------------------------------
# Never put real values in this file or in GitHub. Real values go in:
#   - Vercel: Project → Settings → Environment Variables (for the live site and previews)
#   - Claude Code cloud environment: environment settings → Environment variables (for development)
# Local development: run `npm run db:start` then `npm run env:local`, which writes
# .env.local (ignored by git) with the local database keys and any keys found in the environment.
#
# NEXT_PUBLIC_ values are sent to the browser, so they must never be secrets.

# --- Supabase (database + sign-in) ---------------------------------
# Supabase dashboard → your project → Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe for the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. SECRET. Server only. Bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) ---------------------------------------------
# Stripe dashboard → Developers → API keys. Use test keys (sk_test_/pk_test_) until launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe dashboard → Product catalog → "Season Pass" → the $9.99 one-time price → its ID (price_...).
STRIPE_PRICE_ID=
# Stripe dashboard → Developers → Webhooks → your endpoint → "Signing secret" (whsec_...).
# For local testing this comes from the Stripe CLI (`stripe listen`).
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (AI gift ideas) -------------------------------------
# console.anthropic.com → API Keys. SECRET. Set a monthly spending limit in the console.
# In the Claude Code cloud environment, store it as APP_ANTHROPIC_API_KEY instead
# (so Claude Code itself never uses it); `npm run env:local` copies it here.
ANTHROPIC_API_KEY=

# --- Resend (emails) -----------------------------------------------
# resend.com → API Keys. SECRET.
RESEND_API_KEY=
# The sender, on your verified domain, e.g. GiftLedger <hello@yourdomain.com>
EMAIL_FROM=

# Your own email address. Gets the warning if AI costs look like passing $50 this month.
ADMIN_EMAIL=

# --- Scheduled jobs -------------------------------------------------
# Any long random string (Claude generates one for you). Vercel sends it to the daily reminder job
# so nobody else can trigger it. SECRET.
CRON_SECRET=
# Any long random string. Signs one-click unsubscribe links in emails. SECRET.
UNSUBSCRIBE_SECRET=

# --- Analytics and errors ------------------------------------------
# posthog.com → Project settings → Project API key, and the host (e.g. https://us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# sentry.io → Project settings → Client Keys (DSN). The same value goes in both: the DSN only
# allows sending error reports, so it's safe in the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App -------------------------------------------------------------
# Your support/contact address, shown in the footer and legal pages, e.g. hello@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=
# The public address of the site, no trailing slash. http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
